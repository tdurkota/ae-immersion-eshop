# Example environment file for GitHub Actions secrets
# 
# Copy this to .env.local and fill in with your actual values
# DO NOT COMMIT .env.local to git - it contains sensitive information
# It should be added to .gitignore

# ═══════════════════════════════════════════════════════════════
# AZURE CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Service Principal credentials (entire JSON from 'az ad sp create-for-rbac')
# Get this by running: az ad sp create-for-rbac --name "github-actions-eshop-marketplace" --role contributor --scopes /subscriptions/{SUBSCRIPTION_ID} --sdk-auth
AZURE_CREDENTIALS='{"clientId":"00000000-0000-0000-0000-000000000000","clientSecret":"YOUR_CLIENT_SECRET_HERE","subscriptionId":"00000000-0000-0000-0000-000000000000","tenantId":"00000000-0000-0000-0000-000000000000","activeDirectoryEndpointUrl":"https://login.microsoftonline.com","resourceManagerEndpointUrl":"https://management.azure.com/","activeDirectoryGraphResourceId":"https://graph.windows.net/","sqlManagementEndpointUrl":"https://management.core.windows.net:8443/","galleryEndpointUrl":"https://gallery.azure.com/","managementEndpointUrl":"https://management.core.windows.net/"}'

# Your Azure subscription ID
# Get this by running: az account show --query id -o tsv
AZURE_SUBSCRIPTION_ID='00000000-0000-0000-0000-000000000000'

# Azure resource group name
# Created with: az group create --name eshop-marketplace --location eastus
AZURE_RESOURCE_GROUP='eshop-marketplace'

# Azure region (location)
# Examples: eastus, westus2, northeurope, westeurope
AZURE_LOCATION='eastus'

# ═══════════════════════════════════════════════════════════════
# AZURE CONTAINER REGISTRY (ACR) - For Docker Images
# ═══════════════════════════════════════════════════════════════

# ACR registry name (without .azurecr.io suffix)
# Created with: az acr create --resource-group eshop-marketplace --name eshop-marketplace-acr --sku Standard
# Get this by running: az acr list --query '[0].name' -o tsv
ACR_REGISTRY_NAME='eshop-marketplace-acr'

# ACR login username (usually the service principal client ID)
# Get this by running: az acr credential show --name eshop-marketplace-acr --query username -o tsv
ACR_USERNAME='your-acr-username-here'

# ACR login password
# Get this by running: az acr credential show --name eshop-marketplace-acr --query passwords[0].value -o tsv
# ⚠️ KEEP THIS SECRET - Never commit to git
ACR_PASSWORD='your-acr-password-here'

# ═══════════════════════════════════════════════════════════════
# AZURE FOUNDRY (CHATBOT AI)
# ═══════════════════════════════════════════════════════════════

# Azure OpenAI endpoint URL
# Get this by running: az cognitiveservices account show --name eshop-foundry --resource-group eshop-marketplace --query properties.endpoint -o tsv
FOUNDRY_ENDPOINT='https://eshop-foundry.openai.azure.com/'

# Azure OpenAI API key
# Get this by running: az cognitiveservices account keys list --name eshop-foundry --resource-group eshop-marketplace --query key1 -o tsv
# ⚠️ KEEP THIS SECRET - Never commit to git
FOUNDRY_KEY='your-azure-openai-api-key-here'

# ═══════════════════════════════════════════════════════════════
# LINEAR INTEGRATION
# ═══════════════════════════════════════════════════════════════

# Linear API key
# Get this at: https://linear.app/settings/api → Create API key
# ⚠️ KEEP THIS SECRET - Never commit to git
LINEAR_API_KEY='lin_api_key_xxxxxxxxxxxxxxxxxxxxx'

# Linear GraphQL API endpoint
LINEAR_API_ENDPOINT='https://api.linear.app/graphql'

# Linear issue ID for tracking builds
# Create an issue in Linear first, then use its ID (e.g., ESHOP-1)
LINEAR_BUILD_ISSUE_ID='ESHOP-1'

# ═══════════════════════════════════════════════════════════════
# ASPIRE CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Path to your Aspire AppHost project
ASPIRE_MODULE_PATH='src/eShop.AppHost/eShop.AppHost.csproj'

# ═══════════════════════════════════════════════════════════════
# SETUP INSTRUCTIONS
# ═══════════════════════════════════════════════════════════════
# 
# 1. Copy this file: cp .env.example .env.local
# 
# 2. Fill in each value:
#    - AZURE_CREDENTIALS: Follow the Azure setup guide
#    - AZURE_SUBSCRIPTION_ID: Your subscription ID
#    - AZURE_RESOURCE_GROUP: Name of your resource group
#    - AZURE_LOCATION: Azure region for deployment
#    - FOUNDRY_ENDPOINT: Azure OpenAI endpoint
#    - FOUNDRY_KEY: Azure OpenAI API key
#    - LINEAR_API_KEY: Your Linear API token
#    - LINEAR_API_ENDPOINT: Linear GraphQL endpoint
#    - LINEAR_BUILD_ISSUE_ID: Your Linear issue ID
#
# 3. Make sure .env.local is in .gitignore (should be by default)
#
# 4. Run the setup script: ./scripts/setup-github-secrets.sh
#
# For detailed instructions, see: docs/AZURE_SETUP.md
# For secret configuration, see: docs/GITHUB_ACTIONS_SECRETS.md
