# E2E Test Credentials
# Copy this file to .env and fill in with actual test credentials
# Default test users seeded by Identity.API: alice, bob
# See src/Identity.API/UsersSeed.cs for seed configuration
USERNAME1=your_test_username
PASSWORD=your_test_password

# Custom Playwright base URL (optional)
# Leave empty to use default http://localhost:5045
# Use for testing against different deployments (e.g., staging, custom local port)
# Example: https://localhost:7298 for alternate deployment
PLAYWRIGHT_BASE_URL=http://localhost:5045

# ═══════════════════════════════════════════════════════════════
# AZURE CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Service Principal credentials (entire JSON from 'az ad sp create-for-rbac')
# Get this by running: az ad sp create-for-rbac --name "github-actions-eshop-marketplace" --role contributor --scopes /subscriptions/{SUBSCRIPTION_ID} --sdk-auth
AZURE_CREDENTIALS='{"clientId":"00000000-0000-0000-0000-000000000000","clientSecret":"YOUR_CLIENT_SECRET_HERE","subscriptionId":"00000000-0000-0000-0000-000000000000","tenantId":"00000000-0000-0000-0000-000000000000","activeDirectoryEndpointUrl":"https://login.microsoftonline.com","resourceManagerEndpointUrl":"https://management.azure.com/","activeDirectoryGraphResourceId":"https://graph.windows.net/","sqlManagementEndpointUrl":"https://management.core.windows.net:8443/","galleryEndpointUrl":"https://gallery.azure.com/","managementEndpointUrl":"https://management.core.windows.net/"}'

# Your Azure subscription ID
# Get this by running: az account show --query id -o tsv
AZURE_SUBSCRIPTION_ID='00000000-0000-0000-0000-000000000000'

# Azure resource group name
# Created with: az group create --name eshop-marketplace --location westeurope
AZURE_RESOURCE_GROUP='eshop-marketplace'

# Azure region (location)
# Examples: westeurope, northeurope (policy-enforced)
AZURE_LOCATION='westeurope'

# ═══════════════════════════════════════════════════════════════
# AZURE CONTAINER REGISTRY (ACR) - For Docker Images
# ═══════════════════════════════════════════════════════════════

# ACR registry name (without .azurecr.io suffix)
# Created with: az acr create --resource-group eshop-marketplace --name eshopmarketplaceacr --sku Standard
# Get this by running: az acr list --query '[0].name' -o tsv
ACR_REGISTRY_NAME='eshopmarketplaceacr'

# ACR login username (usually the service principal client ID)
# Get this by running: az acr credential show --name eshopmarketplaceacr --query username -o tsv
ACR_USERNAME='your-acr-username-here'

# ACR login password
# Get this by running: az acr credential show --name eshopmarketplaceacr --query passwords[0].value -o tsv
# ⚠️ KEEP THIS SECRET - Never commit to git
ACR_PASSWORD='your-acr-password-here'

# ═══════════════════════════════════════════════════════════════
# ASPIRE CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Path to your Aspire AppHost project
ASPIRE_MODULE_PATH='src/eShop.AppHost/eShop.AppHost.csproj'

