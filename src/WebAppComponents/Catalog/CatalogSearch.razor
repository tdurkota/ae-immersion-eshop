@inject CatalogService CatalogService
@inject NavigationManager Nav

@if (catalogBrands is not null && catalogItemTypes is not null && catalogSellers is not null)
{
    <aside class="catalog-search">
        <details class="catalog-search-details" open>
            <summary class="catalog-search-summary">
                <span class="catalog-search-title">
                    <img role="presentation" src="icons/filters.svg" />
                    Filters
                    @if (ActiveFilterCount > 0)
                    {
                        <span class="catalog-search-title-count">@ActiveFilterCount</span>
                    }
                </span>
            </summary>

            <div class="catalog-search-body">
                @if (HasActiveFilter)
                {
                    <a class="catalog-search-clear" href="@ResetUri()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M18 6 6 18M6 6l12 12" />
                        </svg>
                        Clear all filters
                    </a>
                }

                <div class="catalog-search-group">
                    <h3>Brand</h3>
                    <div class="catalog-search-group-tags">
                        <a href="@BrandUri(null)"
                           class="catalog-search-tag @(BrandActiveCount == 0 ? "active" : "")">
                            <span>All</span>
                            <span class="catalog-search-tag-count">@BrandCount(null)</span>
                        </a>
                        @foreach (var brand in catalogBrands)
                        {
                            var count = BrandCount(brand.Id);
                            var isActive = IsBrandActive(brand.Id);
                            var isEmpty = count == 0 && !isActive;
                            <a href="@BrandUri(brand.Id)"
                               class="catalog-search-tag @(isActive ? "active" : "") @(isEmpty ? "is-empty" : "")"
                               aria-disabled="@(isEmpty ? "true" : null)">
                                <span>@brand.Brand</span>
                                <span class="catalog-search-tag-count">@count</span>
                            </a>
                        }
                    </div>
                </div>
                <div class="catalog-search-group">
                    <h3>Type</h3>
                    <div class="catalog-search-group-tags">
                        <a href="@TypeUri(null)"
                           class="catalog-search-tag @(TypeActiveCount == 0 ? "active" : "")">
                            <span>All</span>
                            <span class="catalog-search-tag-count">@TypeCount(null)</span>
                        </a>
                        @foreach (var itemType in catalogItemTypes)
                        {
                            var count = TypeCount(itemType.Id);
                            var isActive = IsTypeActive(itemType.Id);
                            var isEmpty = count == 0 && !isActive;
                            <a href="@TypeUri(itemType.Id)"
                               class="catalog-search-tag @(isActive ? "active" : "") @(isEmpty ? "is-empty" : "")"
                               aria-disabled="@(isEmpty ? "true" : null)">
                                <span>@itemType.Type</span>
                                <span class="catalog-search-tag-count">@count</span>
                            </a>
                        }
                    </div>
                </div>
                <div class="catalog-search-group">
                    <h3>Seller</h3>
                    <div class="catalog-search-group-tags">
                        <a href="@SellerUri(null)"
                           class="catalog-search-tag @(SellerActiveCount == 0 ? "active" : "")">
                            <span>All</span>
                            <span class="catalog-search-tag-count">@SellerCount(null)</span>
                        </a>
                        <a href="@SellerUri(Guid.Empty)"
                           class="catalog-search-tag @(IsSellerActive(Guid.Empty) ? "active" : "")">
                            <span>Official Store</span>
                            <span class="catalog-search-tag-count">@OfficialStoreCount</span>
                        </a>
                        @foreach (var seller in catalogSellers.Where(s => s.Id != Guid.Empty))
                        {
                            var count = SellerCount(seller.Id);
                            var isActive = IsSellerActive(seller.Id);
                            var isEmpty = count == 0 && !isActive;
                            <a href="@SellerUri(seller.Id)"
                               class="catalog-search-tag @(isActive ? "active" : "") @(isEmpty ? "is-empty" : "")"
                               aria-disabled="@(isEmpty ? "true" : null)">
                                <span>@seller.Name</span>
                                <span class="catalog-search-tag-count">@count</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </details>
    </aside>
}

@code {
    IEnumerable<CatalogBrand>? catalogBrands;
    IEnumerable<CatalogItemType>? catalogItemTypes;
    IEnumerable<SellerFacet>? catalogSellers;
    CatalogFacets? facets;

    [Parameter] public int[]? BrandIds { get; set; }
    [Parameter] public int[]? TypeIds { get; set; }
    [Parameter] public Guid[]? SellerIds { get; set; }

    private IReadOnlyList<int> Brands => BrandIds ?? [];
    private IReadOnlyList<int> Types => TypeIds ?? [];
    private IReadOnlyList<Guid> Sellers => SellerIds ?? [];

    private int BrandActiveCount => Brands.Count;
    private int TypeActiveCount => Types.Count;
    private int SellerActiveCount => Sellers.Count;

    bool HasActiveFilter => Brands.Count > 0 || Types.Count > 0 || Sellers.Count > 0;
    int ActiveFilterCount => Brands.Count + Types.Count + Sellers.Count;

    private bool IsBrandActive(int id) => Brands.Contains(id);
    private bool IsTypeActive(int id) => Types.Contains(id);
    private bool IsSellerActive(Guid id) => Sellers.Contains(id);

    private int OfficialStoreCount => facets?.SellerCounts.FirstOrDefault(s => s.Id == Guid.Empty)?.Count ?? 0;

    protected override async Task OnInitializedAsync()
    {
        var brandsTask = CatalogService.GetBrands();
        var itemTypesTask = CatalogService.GetTypes();
        var facetsTask = CatalogService.GetCatalogFacets(BrandIds, TypeIds, SellerIds);
        await Task.WhenAll(brandsTask, itemTypesTask, facetsTask);
        catalogBrands = brandsTask.Result;
        catalogItemTypes = itemTypesTask.Result;
        facets = facetsTask.Result;
        catalogSellers = facets?.SellerCounts ?? [];
    }

    // Contextual counts. Within a facet, selections are additive (OR / union); across
    // facets they intersect (AND). The counts come from a server-side aggregation, so a
    // brand option is counted against the active TYPE set and a type option against the
    // active BRAND set, previewing the result of adding that option to the current
    // selection. A facet that is absent from the response has no matching items (count 0).
    private int BrandCount(int? brandId)
    {
        if (facets is null)
        {
            return 0;
        }
        if (brandId is null)
        {
            return facets.BrandTotal;
        }
        foreach (var count in facets.BrandCounts)
        {
            if (count.Id == brandId)
            {
                return count.Count;
            }
        }
        return 0;
    }

    private int TypeCount(int? typeId)
    {
        if (facets is null)
        {
            return 0;
        }
        if (typeId is null)
        {
            return facets.TypeTotal;
        }
        foreach (var count in facets.TypeCounts)
        {
            if (count.Id == typeId)
            {
                return count.Count;
            }
        }
        return 0;
    }

    private int SellerCount(Guid? sellerId)
    {
        if (facets is null)
        {
            return 0;
        }
        if (sellerId is null)
        {
            return facets.SellerCounts.Sum(s => s.Count);
        }
        var seller = facets.SellerCounts.FirstOrDefault(s => s.Id == sellerId);
        return seller?.Count ?? 0;
    }

    private string BrandUri(int? brandId) => Nav.GetUriWithQueryParameters(new Dictionary<string, object?>()
    {
        { "page", null },
        { "brand", ToggleValue(Brands, brandId) },
    });

    private string TypeUri(int? typeId) => Nav.GetUriWithQueryParameters(new Dictionary<string, object?>()
    {
        { "page", null },
        { "type", ToggleValue(Types, typeId) },
    });

    private string SellerUri(Guid? sellerId) => Nav.GetUriWithQueryParameters(new Dictionary<string, object?>()
    {
        { "page", null },
        { "seller", ToggleSeller(Sellers, sellerId) },
    });

    private string ResetUri() => Nav.GetUriWithQueryParameters(new Dictionary<string, object?>()
    {
        { "page", null },
        { "brand", null },
        { "type", null },
        { "seller", null },
    });

    private static int[]? ToggleValue(IReadOnlyList<int> current, int? id)
    {
        if (id is null)
        {
            return null;
        }

        int[] next = current.Contains(id.Value)
            ? current.Where(v => v != id.Value).ToArray()
            : [.. current, id.Value];

        return next.Length == 0 ? null : next;
    }

    private static Guid[]? ToggleSeller(IReadOnlyList<Guid> current, Guid? id)
    {
        if (id is null)
        {
            return null;
        }

        Guid[] next = current.Contains(id.Value)
            ? current.Where(v => v != id.Value).ToArray()
            : [.. current, id.Value];

        return next.Length == 0 ? null : next;
    }
}
